.TH barry 1 "2026-03-17T16:01:59+01:00" "version v4.7.21" "MLKit - a compiler for Standard ML"
.SH NAME
barry \- A fullblown Standard ML compiler 
.SH SYNOPSIS
barry [OPTION]... [file.sml | file.sig | file.mlb]

All possible options are listed below.
.SH DEFAULTS
\fB--SML_LIB\fR You_did_not_set_path_to_install_dir,
\fB-aopt\fR on,
\fB-verbose\fR off,
\fB-c\fR off,
\fB-timings\fR off,
\fB-cfold\fR on,
\fB--contract\fR on,
\fB-cross_opt\fR off,
\fB-debug\fR off,
\fB--debug_linking\fR off,
\fB--debug_man_enrich\fR off,
\fB-dufa\fR on,
